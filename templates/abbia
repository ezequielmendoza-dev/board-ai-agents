#!/usr/bin/env bash

# ==============================================================================
# abbia — Legacy wrapper for BoardAI OS CLI
# ==============================================================================
# Wrapper de compatibilidad hacia atrás que redirige a ./boardai o ejecuta
# la lógica equivalente.
# ==============================================================================

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [ -f "$SCRIPT_DIR/boardai" ]; then
    exec "$SCRIPT_DIR/boardai" "$@"
elif [ -f "./boardai" ]; then
    exec "./boardai" "$@"
fi

# Fallback si no está el binario nuevo localmente
exec bash "$SCRIPT_DIR/../templates/boardai" "$@"
