#!/usr/bin/env bash
# Shim de compatibilidad para templates/boardai
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [ -f "$SCRIPT_DIR/boardai" ]; then
    exec bash "$SCRIPT_DIR/boardai" "$@"
fi
if [ -f "$SCRIPT_DIR/templates/boardai" ]; then
    exec bash "$SCRIPT_DIR/templates/boardai" "$@"
fi
# fallback
exec ./boardai "$@"
